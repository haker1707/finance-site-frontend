    type:t="domination"
    level:t="levels/air_archipelago.bin"
    environment:t="Day"
    weather:t="clear"
    locName:t="Arquipelago Gigante - Ataque aos Depositos"
    locDesc:t="Equipe A ataca tres instalacoes da Equipe B. Cinco pontes destrutiveis sao o objetivo secundario."
    timeLimit:i=90
    scoreLimit:i=1000
    deathPenaltyMul:r=0.0
    allowEmptyTeams:b=yes
    maxRespawns:i=10
    respawnTimeMultiplier:r=0.25
