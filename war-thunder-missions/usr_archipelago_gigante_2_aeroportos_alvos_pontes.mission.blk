    allowedUnitTypes{
      isAirplanesAllowed:b=yes
      isTanksAllowed:b=no
      isShipsAllowed:b=no
      isHelicoptersAllowed:b=yes
    }
  }

  cover_points{}
}

imports{}

triggers{
  isCategory:b=yes
  is_enabled:b=yes

  iniciar_missao{
    is_enabled:b=yes
    comments:t="Cria os dois aeroportos e mostra os objetivos da Equipe A"

    props{
      actionsType:t="PERFORM_ONE_BY_ONE"
      conditionsType:t="ALL"
      enableAfterComplete:b=no
    }

    events{
      initMission{}
    }

    conditions{}

    actions{
      missionMarkAsRespawnPoint{
        loc_name:t="Spawn Aereo Equipe A"
        radius:r=-1.0
        target:t="t1_air_spawn_01"
        target:t="t1_air_spawn_02"
        target:t="t1_air_spawn_03"
        target:t="t1_air_spawn_04"
        target:t="t1_air_spawn_05"
        target:t="t1_air_spawn_06"
        target:t="t1_air_spawn_07"
        target:t="t1_air_spawn_08"
        target:t="t1_air_spawn_09"
        target:t="t1_air_spawn_10"
        team:t="A"
        isStrictSpawn:b=yes
        isStrictPosAndDir:b=yes
        resetStrictSpawnIndex:b=yes
        shouldSpawnAwayFromOtherPlayers:b=yes
        showOnMap:b=yes

        tags{
          air:b=yes
          helicopter:b=yes
          tank:b=no
          ship:b=no
        }
      }

      missionMarkAsRespawnPoint{
        loc_name:t="Spawn Aereo Equipe B"
        radius:r=-1.0
        target:t="t2_air_spawn_01"
        target:t="t2_air_spawn_02"
        target:t="t2_air_spawn_03"
        target:t="t2_air_spawn_04"
        target:t="t2_air_spawn_05"
        target:t="t2_air_spawn_06"
        target:t="t2_air_spawn_07"
        target:t="t2_air_spawn_08"
        target:t="t2_air_spawn_09"
        target:t="t2_air_spawn_10"
        team:t="B"
        isStrictSpawn:b=yes
        isStrictPosAndDir:b=yes
        resetStrictSpawnIndex:b=yes
        shouldSpawnAwayFromOtherPlayers:b=yes
        showOnMap:b=yes

        tags{
          air:b=yes
          helicopter:b=yes
          tank:b=no
          ship:b=no
        }
      }

      airfieldSetProperties{
        object:t="aeroporto_equipe_a"
        object:t="aeroporto_equipe_b"
        enemySurrenderOnLanding:b=yes
      }

      moAddMissionObjective{
        target:t="destruir_alvos_principais"
      }

      moAddMissionObjective{
        target:t="destruir_pontes_secundarias"
      }

      unitSetIndication{
        set:b=yes
        target:t="alvo_municao_b"
        target:t="alvo_combustivel_b_01"
        target:t="alvo_combustivel_b_02"
      }

      unitSetIndication{
        set:b=yes
        target:t="ponte_b_01"
        target:t="ponte_b_02"
        target:t="ponte_b_03"
        target:t="ponte_b_04"
        target:t="ponte_b_05"
      }
    }

    else_actions{}
  }

  verificar_alvos_principais{
    is_enabled:b=yes
    comments:t="Conclui o objetivo principal quando os tres alvos forem destruidos"

    props{
      actionsType:t="PERFORM_ONE_BY_ONE"
      conditionsType:t="ALL"
      enableAfterComplete:b=no
    }

    events{
      periodicEvent{
        time:r=1.0
      }
    }

    conditions{
      unitWhenCountMatches{
        object_type:t="isAlive"
        object_marking:i=0
        func:t="less"
        value:i=1
        object:t="alvo_municao_b"
        object:t="alvo_combustivel_b_01"
        object:t="alvo_combustivel_b_02"
      }
    }

    actions{
      moSetObjectiveStatus{
        target:t="destruir_alvos_principais"
        status:i=2
      }
    }

    else_actions{}
  }

  verificar_pontes_secundarias{
    is_enabled:b=yes
    comments:t="Conclui o objetivo secundario quando as cinco pontes forem destruidas"

    props{
      actionsType:t="PERFORM_ONE_BY_ONE"
      conditionsType:t="ALL"
      enableAfterComplete:b=no
    }

    events{
      periodicEvent{
        time:r=1.0
      }
    }

    conditions{
      unitWhenCountMatches{
        object_type:t="isAlive"
        object_marking:i=0
        func:t="less"
        value:i=1
        object:t="ponte_b_01"
        object:t="ponte_b_02"
        object:t="ponte_b_03"
        object:t="ponte_b_04"
        object:t="ponte_b_05"
      }
    }

    actions{
      moSetObjectiveStatus{
        target:t="destruir_pontes_secundarias"
        status:i=2
      }
    }

    else_actions{}
  }
}

mission_objectives{
  isCategory:b=yes
  is_enabled:b=yes

  destruir_alvos_principais{
    is_enabled:b=no
    comments:t="Objetivo principal da Equipe A"
    type:t="abstractMissionObjective"

    props{
      isPrimary:b=yes
      timeLimit:i=5400
      scoreConst:i=1000
      scoreTime:i=0
    }

    onSuccess{}
    onFailed{}
  }

  destruir_pontes_secundarias{
    is_enabled:b=no
    comments:t="Objetivo secundario opcional da Equipe A"
    type:t="abstractMissionObjective"

    props{
      isPrimary:b=no
      timeLimit:i=5400
      scoreConst:i=500
      scoreTime:i=0
    }

    onSuccess{}
    onFailed{}
  }
}

